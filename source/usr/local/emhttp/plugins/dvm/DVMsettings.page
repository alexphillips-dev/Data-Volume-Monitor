<script type="text/javascript">
<?if($dvm_config_running):?>
function dvmMatchesFilter(filterArray, spanTexts, tdText) {
    return filterArray.some(function (filter) {
        if (filter.includes('+') || filter.includes('!')) {
            let [includePart, excludePart] = filter.split('!');
            let includeKeywords = includePart ? includePart.split('+').map(k => k.trim()) : [];
            let excludeKeywords = excludePart ? excludePart.split('+').map(k => k.trim()) : [];
            let matchesInclusion = includeKeywords.every(keyword => spanTexts.some(name => name === keyword));
            let matchesExclusion = excludeKeywords.length > 0 && excludeKeywords.every(keyword => spanTexts.some(name => name === keyword));
            return matchesInclusion && !matchesExclusion;
        }
        return tdText === filter || spanTexts.some(name => name === filter);
    });
}
var dvmReportsPoll = null;
function getDVMReports() {
    let filters = <?=json_encode($dvm_config_filters, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE);?>;
    let filterArray = filters.split(";").map(filter => filter.trim()).filter(f => f);

    if (!dvmReportsPoll) dvmReportsPoll = DVMPoll.create({
        key: 'getDVMReports', timerStore: timers,
        interval: <?=max(abs(isset($display['refresh']) ? $display['refresh'] : 0),(30 * 1000))?>,
        requests: [{key:'report', data:{mode:'report'}}, {key:'lightreport', data:{mode:'lightreport'}}],
        isActive: function () { return $('.dvm_report').length > 0; },
        render: function (responses) {
            var data = responses.report;

            if (data && data.success && data.success.response) {
                let $tempContainer = $('<div>').html(data.success.response);

                if (filterArray.length > 0) {
                    $tempContainer.find('tr').each(function () {
                        let $tr = $(this);
                        let $firstTd = $tr.find('td').first();
                        let tdText = $firstTd.contents().not($firstTd.children()).text().trim();

                        let spanTexts = $firstTd.find('span span').map(function () {
                            return $(this).text().trim();
                        }).get();

                        let rowMatches = dvmMatchesFilter(filterArray, spanTexts, tdText);

                        if (!rowMatches) {
                            $tr.remove();
                        }
                    });
                }

                $('.dvm_report').html($tempContainer.html());
            }
            var data = responses.lightreport;

            if (data && data.success && data.success.response) {
                let $tempContainer = $('<div>').html(data.success.response);

                if (filterArray.length > 0) {
                    $tempContainer.find('tr').each(function () {
                        let $tr = $(this);
                        let $firstTd = $tr.find('td').first();
                        let tdText = $firstTd.contents().not($firstTd.children()).text().trim();

                        let spanTexts = $firstTd.find('span span').map(function () {
                            return $(this).text().trim();
                        }).get();

                        let rowMatches = dvmMatchesFilter(filterArray, spanTexts, tdText);

                        if (!rowMatches) {
                            $tr.remove();
                        }
                    });
                }

                $('.dvm_lightreport').html($tempContainer.html());
            }
        },
        onState: function (state) {
            DVMPoll.annotate($('.dvm_report, .dvm_lightreport'), $('#dvm_reports_status'), state);
        }
    });
    dvmReportsPoll.start();
}
<?endif;?>

$(function() {

    <?if($dvm_config_running):?>
    getDVMReports();
    <?endif;?>

    showStatus('vnstatd');

    if ( typeof caPluginUpdateCheck === "function" ) {
        caPluginUpdateCheck("dvm.plg",{name:"Data Volume Monitor"});
    }

});
</script>
