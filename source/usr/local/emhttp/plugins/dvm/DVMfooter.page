<script type="text/javascript">
var dvmFooterPoll = null;
function getDVMFooter() {
    if (!dvmFooterPoll) dvmFooterPoll = DVMPoll.create({
        key: 'getDVMFooter', timerStore: timers,
        interval: <?=max(abs(isset($display['refresh']) ? $display['refresh'] : 0),(30 * 1000))?>,
        requests: [{key:'footer', data:{mode:'footer'}}],
        isActive: function () { return $('#dvm_footer').length > 0; },
        render: function (responses) {
            $('#dvm_footer').html(responses.footer.success.response)
                .append('<span id="dvm_footer_status" role="status" aria-live="polite"></span>');
        },
        onState: function (state) {
            var title = <?=json_encode(html_entity_decode($dvm_config_primary, ENT_QUOTES, 'UTF-8').' / '.$dvm_footer_descr, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);?>;
            DVMPoll.annotate($('#dvm_footer'), null, state, title);
            $('#dvm_footer_status').text(state.phase === 'stale' ? (state.lastSuccess === null ? ' Unavailable' : ' Stale') : '')
                .attr('title', DVMPoll.statusText(state));
        }
    });
    dvmFooterPoll.start();
}
$(function()
{
    var dvm_footer = $("<span id='dvm_footer' class='minimal'><span id='dvm_footer_status' role='status' aria-live='polite'></span></span>").attr('title', <?=json_encode(html_entity_decode($dvm_config_primary, ENT_QUOTES, 'UTF-8').' / '.$dvm_footer_descr, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);?>);

    <?if(version_compare(parse_ini_file('/etc/unraid-version')['version'],'7.1.99', '>')):?>
    dvm_footer.appendTo(".footer-right");
    <?else:?>
    dvm_footer.insertAfter("#footer > span#copyright");
    <?endif;?>

    getDVMFooter();
});
</script>
