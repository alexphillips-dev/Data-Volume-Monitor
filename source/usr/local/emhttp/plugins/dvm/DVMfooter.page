<script type="text/javascript">
var dvmDashboardPoll = null;
function getDVMDashboard() {
    if (!dvmDashboardPoll) dvmDashboardPoll = DVMPoll.create({
        key: 'getDVMDashboard', timerStore: timers,
        interval: <?=max(abs(isset($display['refresh']) ? $display['refresh'] : 0),(30 * 1000))?>,
        requests: [{key:'mini', data:{mode:'dashboardmini'}}, {key:'dashboard', data:{mode:'dashboard'}}],
        isActive: function () { return $('.dvm_mini_dash').length > 0; },
        validate: function (responses) { return responses.dashboard.success.response.split(';').length === 10; },
        render: function (responses) {
            $('.dvm_mini_dash').html(responses.mini.success.response);
            var data = responses.dashboard;
            var metrics = data.success.response.split(';');
            $('.dvm_5rx').html(metrics[0]);
            $('.dvm_5tx').html(metrics[1]);
            $('.dvm_hrx').html(metrics[2]);
            $('.dvm_htx').html(metrics[3]);
            $('.dvm_drx').html(metrics[4]);
            $('.dvm_dtx').html(metrics[5]);
            $('.dvm_mrx').html(metrics[6]);
            $('.dvm_mtx').html(metrics[7]);
            $('.dvm_yrx').html(metrics[8]);
            $('.dvm_ytx').html(metrics[9]);

            if(data.success.response.includes("red-text")) {
                $(".dvmorbicon").attr("class","dvmorbicon dvmorbiconactive fa fa-circle red-orb");
                $(".dvmorbicon").attr("title","Monitored - Limits Exceeded");
            } else if(data.success.response.includes("dvm-threshold-error")) {
                $(".dvmorbicon").attr("class","dvmorbicon dvmorbiconactive fa fa-exclamation-triangle");
                $(".dvmorbicon").attr("title","Threshold status unavailable");
            } else if(data.success.response.includes("green-text")) {
                $(".dvmorbicon").attr("class","dvmorbicon dvmorbiconactive fa fa-circle green-orb");
                $(".dvmorbicon").attr("title","Monitored - Limits Not Exceeded");
            } else {
                $(".dvmorbicon").attr("class", "dvmorbicon dvmorbiconactive fa fa-circle dvm-gray-orb");
                $(".dvmorbicon").attr("title","Monitored - No Limits");
            }
        },
        onState: function (state) {
            DVMPoll.annotate($('.dvm_mini_dash'), $('.dvm_dashboard_status'), state);
        }
    });
    dvmDashboardPoll.start();
}
$(function(){
    getDVMDashboard();
});
</script>
