require_once '/usr/local/emhttp/plugins/dvm/include/dvm_config.php';
require_once '/usr/local/emhttp/plugins/dvm/include/dvm_release.php';

require_once '/usr/local/emhttp/plugins/dvm/include/dvm_inventory.php';
$dvm_interface_inventory = dvm_inventory_query("find /sys/class/net/ -maxdepth 1 -type l -printf '%f\n' 2>/dev/null");
$dvm_docker_inventory = dvm_inventory_query("docker ps --format '{{.Names}}' --all 2>/dev/null");
$dvm_vm_inventory = dvm_inventory_query("virsh list --name --all 2>/dev/null");
$dvm_inventory_messages = [];
foreach (['Network interface' => $dvm_interface_inventory, 'Docker' => $dvm_docker_inventory, 'VM' => $dvm_vm_inventory] as $label => $inventory) {
    if ($inventory['status'] === 'error') {
        $dvm_inventory_messages[] = $label.' inventory could not be loaded. Existing selections are retained; refresh after checking the service.';
    } elseif (count($inventory['items']) === 0) {
        $dvm_inventory_messages[] = $label.' inventory is empty. Existing selections are retained.';
    }
}

if($dvm_config_running && $dvm_config_autopurge == "enable") {
    shell_exec("/usr/local/emhttp/plugins/dvm/scripts/clean_db");
}

$custom_iface_string = "{$dvm_config_custom1_interface};{$dvm_config_custom2_interface};{$dvm_config_custom3_interface};{$dvm_config_custom4_interface};{$dvm_config_custom5_interface};{$dvm_config_custom6_interface}";
$custom_iface_array = explode(";", trim($custom_iface_string)) ?? [];
$double_primary = in_array($dvm_config_primary,$custom_iface_array);

?>

<?if ($double_primary):?>
<div style="border: 3px solid red;padding: 5px;color: red;">
    You have configured at least one secondary interface threshold to monitor your configured primary network interface.<br>
    <strong>Please use the primary interface thresholds to monitor the primary interface</strong>, secondary interface thresholds have no effect on the primary interface.
</div><br>
<?endif;?>

<?if ($dvm_inventory_messages):?>
<div class="dvm-inventory-status" role="status">
<?foreach ($dvm_inventory_messages as $message):?>
    <p><?=htmlspecialchars($message, ENT_QUOTES, 'UTF-8');?></p>
<?endforeach;?>
</div>
<?endif;?>

