<script type="text/javascript">
function checkRUNNING(){
   if ($('#SERVICE').val() === 'enable')
        $('#command').val('/usr/local/emhttp/plugins/dvm/scripts/start');
    else
        $('#command').val('/usr/local/emhttp/plugins/dvm/scripts/stop');
    if ("<?=$dvm_config_running;?>" == 1){
        $('.dvm-run').prop('disabled', true);
        $('#RESTART').prop('disabled', false);
        $('#CLEANDB').prop('disabled', false);
        $('#TESTACTIONS').prop('disabled', false);
    }else{
        $('.dvm-run').prop('disabled', false);
        $('#RESTART').prop('disabled', true);
        $('#CLEANDB').prop('disabled', true);
        $('#TESTACTIONS').prop('disabled', true);
    }
}
function checkLIMITS(){
    $('.dvmlimit, .dvmlimit2').each(function() {
        var input = $(this), statusId = this.id+'-status';
        var status = input.siblings('.dvm-limit-status');
        if (!status.length) {
            status = $('<span>').attr({id:statusId, role:'status', 'aria-live':'polite'})
                .addClass('dvm-limit-status');
            input.parent().append(status);
        }
        // Match the evaluator's trimmed positive integer and uint64 limit rules
        // without converting large decimal values to imprecise JS numbers.
        var value = input.val().replace(/^[ \t\n\r\0\v]+|[ \t\n\r\0\v]+$/g, '');
        var digits = value.replace(/^0+/, '');
        var enabled = /^[0-9]+$/.test(value) && digits.length > 0 &&
            (digits.length < 20 || (digits.length === 20 && digits <= '18446744073709551615'));
        var label = value === '-1' ? 'Disabled' : (enabled ? 'Enabled' : 'Invalid');
        if (status.text() !== label) status.text(label);
        status.toggleClass('red-text', !enabled).toggleClass('green-text', enabled).show();
        var descriptions = (input.attr('aria-describedby') || '').split(/\s+/).filter(function(id) {
            return id && id !== statusId;
        });
        descriptions.push(statusId);
        input.attr('aria-describedby', descriptions.join(' '));
    });
}
function Restart(){
    $('#command').val('/usr/local/emhttp/plugins/dvm/scripts/restart');
    $('#dvm-settings').submit();
}
function ResetConfig(){
    $('#command').val('');
    openBox('/usr/local/emhttp/plugins/dvm/scripts/resetconf', 'DVM Reset Config', 600, 600, true);
}
function ResetAll(){
    $('#command').val('');
    openBox('/usr/local/emhttp/plugins/dvm/scripts/resetall', 'DVM Reset All', 600, 600, true);
}
function CleanDB(){
    $('#command').val('');
    openBox('/usr/local/emhttp/plugins/dvm/scripts/clean_db', 'DVM Database Purger', 600, 600, true);
}
function ManualCheck(){
    openBox('/usr/local/emhttp/plugins/dvm/scripts/manual_check', 'DVM Manual Check', 600, 600, false);
}
$(function() {

    $('form input:not([type="submit"])').keydown(function(e) {
        if (e.keyCode == 13) {
            e.preventDefault();
            return false;
        }
    });

    $('#btnApply').click(function(){
        $('#dvm-settings').submit();
    });
    $('#btnApply2').click(function(){
        $('#dvm-display').submit();
    });
    $('#btnApply3').click(function(){
        $('#dvm-alarms').submit();
    });

    $('#RESTART').click(Restart);
    $('#MANUALCHECK').click(ManualCheck);
    var actionOutcomes = DVMOutcomes.create($('#dvm_outcomes_body'), $('#dvm_outcomes_status'));
    $('#TESTACTIONS').click(actionOutcomes.testActions);
    $('#REFRESHOUTCOMES').click(actionOutcomes.refresh);

    if (typeof swal === "function") {
        $('#RESETCONF').click(function(){ swal({title:"Are you sure?",text:"DVM configuration will be returned to the default state.<br>DVM database <u>will not be wiped</u> of any of its contents!",type:"warning",html:true,showCancelButton:true}, ResetConfig); });
        $('#RESETALL').click(function(){ swal({title:"Are you sure?",text:"DVM configuration will be returned to the default state.<br>DVM database <u>will be wiped</u> of all of its contents!",type:"warning",html:true,showCancelButton:true}, ResetAll); });
        $('#CLEANDB').click(function(){ swal({title:"Are you sure?",text:"All not currently existing network interfaces <u>and all their recorded data volume information</u> will be removed from the DVM database!",type:"warning",html:true,showCancelButton:true}, CleanDB); });
    } else {
        $('#RESETCONF').click(ResetConfig);
        $('#RESETALL').click(ResetAll);
        $('#CLEANDB').click(CleanDB);
    }

    $('#SERVICE').change(checkRUNNING);
    $('.dvmlimit, .dvmlimit2').on('input change', checkLIMITS);

    checkRUNNING();
    checkLIMITS();

});
</script>
